e-text-3")}];l.forEach(e=>{e.element&&(e.element.style.display="none")});const i=[],a=[],c=[],d=l.sort(()=>Math.random()-.5);let r=0;for(let t=0;t<d.length&&r<e;t++){const e=d[t];if(e.element){let t,o,n;if("icon"===e.type){let e;do{e=tvetIcons[Math.floor(Math.random()*tvetIcons.length)]}while(i.includes(e)&&i.length<tvetIcons.length);if(!(i.length<tvetIcons.length))continue;i.push(e),t=e}else{let e;do{e=displayTexts[Math.floor(Math.random()*displayTexts.length)]}while(a.includes(e)&&a.length<displayTexts.length);if(!(a.length<displayTexts.length))continue;a.push(e),t=e}let l=!1,d=0;do{o=70*Math.random()+10,n=80*Math.random()+5,l=!lastPositions.some(e=>Math.abs(e.top-o)<10&&Math.abs(e.left-n)<10),d++}while(!l&&d<10);c.push({top:o,left:n}),e.element.style.display="flex",e.element.style.top=o+"%",e.element.style.left=n+"%",e.element.style.right="auto",e.element.textContent=t,console.log("[Item "+r+"] Type: "+e.type+", Content: "+t+" at "+o.toFixed(1)+"%, "+n.toFixed(1)+"%"),r++}}lastPositions=c}document.addEventListener("DOMContentLoaded",function(){randomizeParticlesCompletely(),setInterval(randomizeParticlesCompletely,1e4)}),window.addEventListener("load",function(){randomizeParticlesCompletely()}),window.addEventListener("load",function(){document.querySelectorAll(".floating-particle").forEach(e=>{e.style.display=""})})</script></body></html>